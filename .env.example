# Every setting of the backend, with its default. Copy to .env and change
# what you need; a variable left out keeps its default.

# Address to listen on.
ONP_LISTEN=:8080

# SQLite database file.
ONP_DB_PATH=oggi-non-posso.db

# Directory with the built frontend (frontend/dist). Empty: API only.
ONP_STATIC_DIR=

# Days after its last candidate day when an event is deleted. 0 keeps
# events for ever.
ONP_RETENTION_DAYS=30

# Participants per event.
ONP_MAX_PARTICIPANTS=50

# Rate limits on creating events and joining (true or false).
ONP_RATE_LIMIT=true

# Header holding the client address when the service sits behind a trusted
# proxy, for example X-Forwarded-For (its last element is used). Empty: the
# address of the connection.
ONP_CLIENT_IP_HEADER=

# debug, info, warn or error.
ONP_LOG_LEVEL=info
